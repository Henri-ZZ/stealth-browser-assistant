{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Stealth Tabs",
  "version": "0.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stealth Tabs",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-mute": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "__MSG_cmdToggleMute__"
    },
    "toggle-hide": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "__MSG_cmdToggleHide__"
    },
    "emergency-mode": {
      "suggested_key": { "default": "Alt+Shift+Space" },
      "description": "__MSG_cmdToggleEmergency__"
    }
  }
}